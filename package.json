{
  "name": "belleza-saludable",
  "version": "1.0.0",
  "description": "Sistema de gestión de turnos - Belleza Saludable",
  "scripts": {
    "dev": "node backend/server.js",
    "start": "node backend/server.js",
    "build": "cd frontend && npm install && npm run build",
    "seed": "node backend/db/seed.js",
    "seed:test": "node backend/db/seed-test-data.js",
    "migrate": "node backend/db/migrate.js",
    "setup": "node backend/db/setup.js",
    "test": "jest --testPathPattern=backend/tests --runInBand",
    "test:watch": "jest --testPathPattern=backend/tests --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/backend/tests/**/*.test.js"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.22",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "nodemailer": "6.9.14",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
