
# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/belleza_saludable

# Entorno
NODE_ENV=development
PORT=3000

# Email (SMTP) - Configuración para envío de confirmaciones de turno
# Si no se configuran, los emails se omiten silenciosamente sin afectar las reservas.
#
# Ejemplo con Gmail (requiere "contraseña de aplicación" con 2FA activado):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tu_cuenta@gmail.com
#   SMTP_PASS=xxxx_xxxx_xxxx_xxxx   # contraseña de aplicación, NO la contraseña de Gmail
#
# Ejemplo con otro proveedor SMTP (ej. SendGrid, Brevo, Mailgun):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxxxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Belleza Saludable
